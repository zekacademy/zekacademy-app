  "celdiriciler": {
   "A": "Beşgen yerine dörtgenin iç açılar toplamını (360°) alıp (360° − 330°) ÷ 2 = 15 bulmuş.",
   "B": "İç açı yerine komşu dış açıyı hesaplamış: 180° − 105° = 75°.",
   "D": "Beşgen yerine altıgenin iç açılar toplamını (720°) alıp (720° − 330°) ÷ 2 = 195 bulmuş.",
   "E": "Kalan toplamı 540° − 330° = 210° bulup iki açıya bölmeyi unutmuş."
  },
  "celTur": {
   "A": "bilgi",
   "B": "dikkat",
   "D": "bilgi",
   "E": "dikkat"
  },
  "istenen": "x = m(D) = m(E) açısının ölçüsü (derece).",
  "bilgi": [
   {
    "ad": "İç ve dış açılar",
    "ifade": "n kenarlı konveks çokgenin iç açıları toplamı (n − 2) × 180° dir; dış açıları toplamı 360° dir. Bir iç açı ile komşu dış açının toplamı 180° dir. Örnek: yedigenin iç açıları toplamı 5 × 180° = 900°"
   }
  ],
  "ipuclari": [
   "Kenar sayısına bakarak çokgenin iç açıları toplamını bul; verilen üç açıyı toplamdan çıkınca kalan kaç açıya ait?"
  ],
  "adimlar": [
   {
    "baslik": "İç açılar toplamını yaz",
    "aciklama": "Beş kenarlı çokgenin iç açılar toplamı (5 − 2) × 180° dir.",
    "islem": "3 × 180° = 540°"
   },
   {
    "baslik": "Bilinen açıları çıkar",
    "aciklama": "A, B ve C açıları verilmiştir.",
    "islem": "100° + 120° + 110° = 330° → kalan 540° − 330° = 210°"
   },
   {
    "baslik": "Eşit iki açıya böl",
    "aciklama": "Kalan 210°, D ve E açılarına eşit paylaşılır.",
    "islem": "2x = 210° → x = 105°"
   }
  ],
  "puf": "n kenarlı çokgenin iç açılar toplamı (n − 2) × 180° dir; eşit açılar kalan toplamın bölünmesiyle bulunur.",
