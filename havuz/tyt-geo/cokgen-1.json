  "celdiriciler": {
   "B": "İç açı olan 108° nin yarısını almış.",
   "C": "Dış açıyı (72°) bulup üçgenin üçüncü açısını hesaplamadan cevap yazmış.",
   "D": "Beşgenin bir iç açısını (108°) cevap sanmış.",
   "E": "İki dış açıyı toplayıp (72° + 72° = 144°) üçgenin üçüncü açısını bulmamış."
  },
  "celTur": {
   "B": "bilgi",
   "C": "dikkat",
   "D": "dikkat",
   "E": "dikkat"
  },
  "istenen": "x = m(BFC) açısının ölçüsü (derece).",
  "bilgi": [
   {
    "ad": "Düzgün çokgen",
    "ifade": "tüm kenarları ve tüm açıları eşit olan çokgendir. n kenarlı düzgün çokgenin bir dış açısı 360° ÷ n, bir iç açısı 180° − 360° ÷ n dir. Örnek: düzgün sekizgende dış açı 45°, iç açı 135° dir"
   }
  ],
  "ipuclari": [
   "B ve C köşelerinde uzatılan kenarlarla BC kenarı arasında kalan açılar, beşgenin hangi açısıyla ilişkilidir?"
  ],
  "adimlar": [
   {
    "baslik": "Dış açıyı bul",
    "aciklama": "Düzgün beşgenin bir dış açısı 360° ÷ 5 dir.",
    "islem": "360° ÷ 5 = 72°"
   },
   {
    "baslik": "Üçgenin açılarını yaz",
    "aciklama": "FBC üçgeninde B ve C açıları, uzatılan kenarların oluşturduğu dış açılara eşittir.",
    "islem": "m(FBC) = m(FCB) = 72°"
   },
   {
    "baslik": "Üçüncü açıyı bul",
    "aciklama": "Üçgenin iç açıları toplamı 180° dir.",
    "islem": "x = 180° − 72° − 72° = 36°"
   }
  ],
  "puf": "Düzgün n-genin uzatılan komşu kenarları arasındaki açı, iki dış açı toplamı 180° den çıkarılarak bulunur: 180° − 2 × 360°/n.",
