rules_version = '2';
// Zekacademy güvenlik kuralları
// - Koç (zekacademy@app.zekacademy.com) her şeyi okur ve yazar.
// - Öğrenci sadece kendi kaydını okur/yazar; koça ait alanları (koçtan not, hedef netler, görüşme günleri) değiştiremez.
// - Koçun özel notları (coachNotes) sadece koça açık.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach() { return signedIn() && request.auth.token.email == 'zekacademy@app.zekacademy.com'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function coachOnlyKeys() { return ['koctanNot', 'hedef', 'donem', 'programYeni', 'kullanici', 'sbAd', 'aiBonus']; }

    match /students/{uid} {
      allow read: if isCoach() || isSelf(uid);
      allow create: if isCoach()
        || (isSelf(uid) && request.resource.data.get('ilkSifre', false) == false
            && request.resource.data.get('koctanNot', null) == null
            && !request.resource.data.keys().hasAny(['donem', 'programYeni']));
      allow update: if isCoach()
        || (isSelf(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(coachOnlyKeys())
            && (request.resource.data.get('ilkSifre', false) == false || resource.data.get('ilkSifre', false) == true));
      allow delete: if isCoach();
    }

    match /coachDevices/{id} {
      allow read, write: if isCoach();
    }

    match /koc/{id} {
      allow read: if isCoach();
      allow write: if false;
    }

    match /system/{id} {
      allow read, write: if false;
    }

    match /coachNotes/{uid} {
      allow read, write: if isCoach();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /gorusmeler/{id} {
      allow read, write: if isCoach();
    }
    // Takıldığım sorular: öğrenci kendi sorularını ekler/okur/günceller/siler; koç hepsini görür. Fotoğraf ayrı belgede.
    match /sorular/{id} {
      allow read: if isCoach() || (signedIn() && resource.data.sid == request.auth.uid);
      allow create: if isCoach() || (signedIn() && request.resource.data.sid == request.auth.uid);
      allow update: if isCoach() || (signedIn() && resource.data.sid == request.auth.uid && request.resource.data.sid == resource.data.sid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kocNot']));
      allow delete: if isCoach() || (signedIn() && resource.data.sid == request.auth.uid);
    }
    match /soruFoto/{id} {
      allow read, delete: if isCoach() || (signedIn() && resource.data.sid == request.auth.uid);
      allow create: if isCoach() || (signedIn() && request.resource.data.sid == request.auth.uid && request.resource.data.data.size() < 900000);
      allow update: if isCoach();
    }
    // Soru Çözüm: kullanım sayaçları ve soru kayıtları sadece sunucu tarafından yazılır; öğrenci kendisininkini okur
    match /aiKullanim/{id} {
      allow read: if isCoach() || (signedIn() && resource.data.sid == request.auth.uid);
      allow write: if isCoach();
    }
    match /aiSorular/{id} {
      allow read: if isCoach() || (signedIn() && resource.data.sid == request.auth.uid);
      allow delete: if isCoach();
      allow create, update: if false;
    }
    // Çalışma grupları: koç kurar; üyeler grubu ve birbirinin canlı özetini (takma ad, kronometre) görür.
    // Her öğrenci sadece kendi özetini yazar; gerçek ad ve diğer veriler bu belgede yok.
    function grupUyesi(gid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/gruplar/$(gid)).data.uyeler; }
    match /gruplar/{gid} {
      allow read: if isCoach() || (signedIn() && request.auth.uid in resource.data.uyeler);
      allow write: if isCoach();
      match /canli/{uid} {
        allow read: if isCoach() || grupUyesi(gid);
        allow delete: if isCoach();
        allow create, update: if isCoach() || (isSelf(uid) && grupUyesi(gid)
          && request.resource.data.keys().hasOnly(['takma', 'basla', 'ders', 'gun', 'bugunDk', 'gunler', 'at'])
          && request.resource.data.takma is string && request.resource.data.takma.size() <= 16);
      }
    }
    match /notifs/{id} {
      allow read, update, delete: if isCoach();
      allow create: if isCoach() || signedIn() && request.resource.data.sid == request.auth.uid
        && request.resource.data.type in ['kayit'] && request.resource.data.read == false;
    }
  }
}
